# Eon8 Blog CMS & Admin Portal Configuration
# Hidden URL route for the Admin Dashboard (must start with /)
VITE_ADMIN_PATH=/admin-dashboard

# Initial Admin Credentials (seeded on first run into gitignored data/cms-auth.json;
# can be updated anytime from inside the Admin Dashboard -> Security & Account)
CMS_ADMIN_EMAIL=admin@eon8.com
CMS_ADMIN_PASSWORD=ChangeMe@Eon8_2026!
CMS_SESSION_SECRET=replace-with-a-random-64-char-secret-in-production

# Optional Lead Webhook
# VITE_LEAD_WEBHOOK_URL=

# Future Supabase Adapter (set VITE_CMS_PROVIDER=supabase when ready)
# VITE_CMS_PROVIDER=api
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
