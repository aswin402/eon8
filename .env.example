# Eon8 Blog CMS & Production Server Configuration
# Hidden URL route for the Admin Dashboard (must start with /)
VITE_ADMIN_PATH=/admin-dashboard

# Required Admin Credentials (seeded on first run into gitignored data/cms-auth.json;
# can be rotated anytime inside Admin Dashboard -> Security & Account).
# Production refuses to start with missing, weak (<10 chars), or placeholder values.
CMS_ADMIN_EMAIL=you@company.com
CMS_ADMIN_PASSWORD=
# Generate a 64-char hex secret via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_SESSION_SECRET=

# Production Server Networking & Cookies
PORT=4173
# Set TRUST_PROXY=true ONLY when running behind a trusted reverse proxy (Nginx / Caddy / Cloudflare)
TRUST_PROXY=false
# Automatically true on HTTPS / NODE_ENV=production; set false ONLY for local HTTP `npm start` testing
# CMS_COOKIE_SECURE=true
# Redirect legacy root-level blog URLs (/<slug>) to canonical /blog/<slug> with HTTP 301 (default: true)
BLOG_ROOT_REDIRECT=true

# Server-Side Lead Notification Webhook (recommended: Slack, Zapier, Make, n8n, HubSpot, Resend/Brevo)
# Incoming form submissions always persist to gitignored data/leads.json (visible in Admin -> Leads Inbox)
# and are also forwarded server-side to this URL when set:
# LEAD_WEBHOOK_URL=https://hooks.example.com/eon8-leads
# LEAD_WEBHOOK_SECRET=

# Optional Client-Side Fallback Webhook (only used when running static preview without Node server)
# VITE_LEAD_WEBHOOK_URL=

# Future Supabase Adapter (set VITE_CMS_PROVIDER=supabase when ready)
# VITE_CMS_PROVIDER=api
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
