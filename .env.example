# Copy this file to .env and fill in the values. Never commit .env.

# --- Site ---------------------------------------------------------------------
NODE_ENV=development
PORT=4173
# Public URL, used for canonical and share-image links injected into pages.
SITE_URL=https://www.eon8.com
# Hosts treated as "this site" when importing redirects with absolute URLs.
SITE_HOSTS=eon8.com,www.eon8.com
# Hidden admin route (must start with /). Also used by the React app.
VITE_ADMIN_PATH=/admin-dashboard
# Set to 1 only when the app runs behind a reverse proxy (Nginx, Cloudflare)
# that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=0

# --- Database (PostgreSQL) ----------------------------------------------------
# Local development: `docker compose up -d db` matches this URL.
# With docker-compose.prod.yml, leave DATABASE_URL out and set POSTGRES_PASSWORD instead.
DATABASE_URL=postgres://eon8:eon8_local_dev@127.0.0.1:5433/eon8
# POSTGRES_PASSWORD=

# --- Encryption of lead personal data at rest ------------------------------------
# Lead names, emails, phone numbers, messages, notes, page URLs, referrers and
# browser details are stored encrypted (AES-256-GCM) when this key is set.
# Create it with:   openssl rand -hex 32     (64 hex characters = 32 bytes)
# WARNING: if this key is lost, the lead details saved with it are lost for good
# (backups do not help: they hold the same encrypted values). Keep a copy in the
# company password manager. Never commit it to git or paste it into tickets/chat.
# Without a key leads are saved in plain text (fine for local development; the
# server logs a warning in production). Existing plain-text leads are encrypted
# automatically on the next start after the key is set.
DATA_ENCRYPTION_KEY=
# Key rotation only: put the previous key here and a new one above, restart, and
# the server re-encrypts all leads with the new key (it logs when this is done);
# then remove DATA_ENCRYPTION_KEY_OLD.
# DATA_ENCRYPTION_KEY_OLD=

# --- Backups (deploy/backup.sh) -------------------------------------------------
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_RCLONE_REMOTE=
# Encrypts the database dump and uploads archive (openssl AES-256, PBKDF2).
# Strongly recommended, and required in practice when BACKUP_RCLONE_REMOTE is set.
# Use a long random value (openssl rand -base64 32) and keep it in the company
# password manager: without it the backups cannot be restored.
# BACKUP_PASSPHRASE=
# DATABASE_SSL=require
# DATABASE_POOL_MAX=10

# --- First admin account --------------------------------------------------------
# Used once, when no admin exists, to create the first administrator.
# The password must be at least 12 characters with three of: lowercase,
# uppercase, numbers, symbols. Remove it from .env after the first start.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
# Admin session length in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168

# --- Email (lead notifications) -----------------------------------------------
# Without SMTP, leads are still saved and shown in the admin; emails are skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=1   # use for port 465
MAIL_FROM="EON8 Website <noreply@eon8.com>"
# Used only until recipients are set in Admin > Settings > Leads (comma-separated).
LEAD_NOTIFY_EMAILS=
# Random string used to hash visitor IPs stored with leads.
LEAD_IP_SALT=

# --- Optional -----------------------------------------------------------------
# Extra webhook that also receives every lead (e.g. a CRM). Leave empty if unused.
# VITE_LEAD_WEBHOOK_URL=
# Old WordPress post URLs (/<slug>/) redirect with 301 to /blog/<slug>/. Set false to serve them in place.
# BLOG_ROOT_REDIRECT=true
